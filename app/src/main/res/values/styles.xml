<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Zen" parent="" />

    <style name="ShapeAppearance.Zen" parent="ShapeAppearance.Material3.Corner.Medium" />

    <style name="ShapeAppearance.Zen.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/metric_card_radius</item>
    </style>

    <style name="ShapeAppearance.Zen.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_radius</item>
    </style>

    <style name="Widget.Zen.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/zen_surface_elevated</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@color/zen_card_glow</item>
        <item name="rippleColor">@color/zen_sage_container</item>
        <item name="android:foreground">@drawable/fg_card_glow</item>
    </style>

    <style name="Widget.Zen.Card.Metric">
        <item name="cardCornerRadius">@dimen/metric_card_radius</item>
        <item name="cardBackgroundColor">@color/zen_surface_elevated</item>
        <item name="android:foreground">@drawable/fg_card_glow_metric</item>
    </style>

    <style name="Widget.Zen.Button" parent="Widget.Material3.Button" />

    <style name="Widget.Zen.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/zen_sage</item>
        <item name="android:textColor">@color/zen_on_sage</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Zen.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/zen_divider</item>
        <item name="android:textColor">@color/zen_text_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Zen.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/zen_sage</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.Zen.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <style name="Widget.Zen.Chip" parent="Widget.Material3.Chip.Filter" />

    <style name="Widget.Zen.Chip.Range" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/zen_surface_secondary</item>
        <item name="android:textColor">@color/zen_text_primary</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
    </style>

    <style name="Widget.Zen.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/zen_surface</item>
        <item name="itemIconTint">@color/bottom_nav_item_tint</item>
        <item name="itemTextColor">@color/bottom_nav_item_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Zen.BottomNav.ActiveIndicator</item>
        <item name="itemRippleColor">@color/zen_sage_container</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Zen.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/zen_sage_container</item>
    </style>

    <style name="Widget.Zen.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/zen_divider</item>
    </style>
</resources>

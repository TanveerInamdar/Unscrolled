<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@null"
        android:padding="12dp"
        android:src="@drawable/ic_leaf" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        android:text="@string/usage_gate_title"
        android:textAppearance="@style/TextAppearance.Zen.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:text="@string/usage_gate_body"
        android:textAppearance="@style/TextAppearance.Zen.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/enableUsageAccessButton"
        style="@style/Widget.Zen.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/open_usage_access_settings" />
</LinearLayout>

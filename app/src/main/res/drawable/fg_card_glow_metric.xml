<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/metric_card_radius" />
            <stroke
                android:width="6dp"
                android:color="@color/zen_card_glow_soft" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="2.5dp"
                android:color="@color/zen_card_glow" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:bottom="3.5dp"
        android:left="3.5dp"
        android:right="3.5dp"
        android:top="3.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <stroke
                android:width="@dimen/card_stroke"
                android:color="@color/zen_card_rim" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>

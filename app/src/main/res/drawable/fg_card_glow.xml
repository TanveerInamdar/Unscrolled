<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <stroke
                android:width="7dp"
                android:color="@color/zen_card_glow_soft" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="3dp"
                android:color="@color/zen_card_glow" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="@dimen/card_stroke"
                android:color="@color/zen_card_rim" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zen_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingTop="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/coach_title"
                android:textAppearance="@style/TextAppearance.Zen.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/coach_subtitle"
                android:textAppearance="@style/TextAppearance.Zen.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/coachNewChatButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/coach_new_chat"
            android:src="@drawable/ic_new_chat" />
    </LinearLayout>

    <TextView
        android:id="@+id/coachSetupText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/screen_padding"
        android:text="@string/coach_setup_needed"
        android:textAppearance="@style/TextAppearance.Zen.Body"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/coachChatPane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/coachMessageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            tools:listitem="@layout/item_coach_assistant" />

        <LinearLayout
            android:id="@+id/coachEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_leaf" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/coach_empty_title"
                android:textAppearance="@style/TextAppearance.Zen.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/coach_empty_hint"
                android:textAppearance="@style/TextAppearance.Zen.Body" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/coachPromptGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center">

                <com.google.android.material.chip.Chip
                    android:id="@+id/promptWeek"
                    style="@style/Widget.Zen.Chip.Range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coach_prompt_week" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/promptPlan"
                    style="@style/Widget.Zen.Chip.Range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coach_prompt_plan" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/promptTime"
                    style="@style/Widget.Zen.Chip.Range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coach_prompt_time" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/promptImprove"
                    style="@style/Widget.Zen.Chip.Range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coach_prompt_improve" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/promptHealth"
                    style="@style/Widget.Zen.Chip.Range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coach_prompt_health" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/coachTypingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/zen_sage" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/coach_typing"
            android:textAppearance="@style/TextAppearance.Zen.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/coachErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_xl"
        android:textAppearance="@style/TextAppearance.Zen.Caption"
        android:textColor="@color/zen_error"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/coachRetryButton"
        style="@style/Widget.Zen.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/space_md"
        android:text="@string/coach_retry"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/coachComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_composer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_xs">

            <EditText
                android:id="@+id/coachInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/coach_input_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="44dp"
                android:textColor="@color/zen_text_primary"
                android:textColorHint="@color/zen_text_tertiary" />

            <ImageButton
                android:id="@+id/coachSendButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="@dimen/space_xs"
                android:background="@drawable/bg_send_circle"
                android:contentDescription="@string/coach_send"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
